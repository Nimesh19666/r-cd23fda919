# Template only. Copy to .env and fill in real values. NEVER commit .env.

# Postgres connection string (from Neon). Must start with postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Day-ahead decision assumption (clock time on D-1, in the timezone below)
DECISION_CUTOFF_LOCAL=09:00
DECISION_TIMEZONE=Europe/London
